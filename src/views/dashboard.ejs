<div class="grid grid-cols-2 md:grid-cols-4 gap-5 mt-30 w-[90%]">
<% List.forEach(product => {%>
<div
        class="group overflow-hidden rounded-2xl border border-stone-200/80 bg-transparent shadow-sm transition duration-200 hover:-translate-y-1 hover:border-amber-300 hover:shadow-lg"
      >
        <div class="relative aspect-square overflow-hidden bg-stone-50">
          <img
            src="<%=product.image_url%>"
            alt=""
          />
        </div>
        <div class="p-3">
          <p
            class="line-clamp-2 min-h-10 text-sm font-semibold leading-5 text-white"
          >
            <%=product.name%>
          </p>
          <span
            class="<%= product.platform === 'tiki' ? 'bg-blue-500/25 border border-blue-500/30 text-blue-400' : '' %> self-start w-fit px-2.5 py-0.5 rounded-2xl text-sm font-bold uppercase my-3"
          >
            <%= product.platform %>
          </span>
          <div class="mt-3 flex flex-wrap items-baseline gap-2">
            <span class="text-lg font-extrabold text-amber-600">
              <%= product.current_price%>đ
            </span>
          </div>
          <div class="my-3 border-t border-stone-100"></div>
          <div
            class="flex items-center justify-between gap-1 text-xs text-stone-500"
          ></div>
          <button
          onclick="window.location.href='/product/<%=product.platform%>/<%=product.product_code%>'"
            class="mt-3 w-full rounded-xl bg-amber-50 py-2.5 text-sm font-semibold cursor-pointer text-amber-800 transition hover:bg-[#e09e2d] hover:text-white"
          >
            Xem thêm
          </button>
        </div>
      </div>    
<%}); %>

</div>
