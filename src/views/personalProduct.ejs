<div class="w-[90%] md:mt-30 mx-auto">
    <p class="text-center text-3xl text-white">Danh sách theo dõi của <span class="text-[#e09e2d]"><%=List[0].email%></span></p>
    <p class="text-xl text-slate-400 text-center md:text-end mb-5">Đang theo dõi <span class="text-[#e09e2d]"><%=List.length%></span> sản phẩm</p>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-5 ">
    <% List.forEach(product => {%>
    <div
            class="group relative overflow-hidden rounded-2xl border border-stone-200/80 bg-transparent shadow-sm transition duration-200 hover:-translate-y-1 hover:border-amber-300 hover:shadow-lg"
          >
            <div class="aspect-square overflow-hidden bg-stone-50">
              <img
                src="<%=product.image_url%>"
                alt=""
              />
<form action="/subscription/delete/<%=product.user_id%>/<%=product.product_id%>" method="post">
    <button 
      type="submit"
      title="Hủy theo dõi"
      class="hover:cursor-pointer hover:scale-[105%] absolute top-3 right-3 w-10 h-10 rounded-full bg-white/80 hover:bg-rose-50 text-slate-400 hover:text-rose-500 border border-slate-200/80 shadow-sm flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-200"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
      </svg>
    </button>
</form>
            </div>
            <div class="p-3">
              <p
                class="line-clamp-2 min-h-10 text-sm font-semibold leading-5 text-white mb-3"
              >
                <%=product.name%>
              </p>
              <span
                class="<%= product.platform === 'tiki' ? 'bg-blue-500/25 border border-blue-500/30 text-blue-400' : '' %> self-start w-fit px-2.5 py-0.5 rounded-2xl text-sm font-bold uppercase my-3"
              >
                <%= product.platform %>
              </span>
              <div class="mt-3 flex flex-wrap items-baseline">
                <span class="text-lg font-extrabold text-amber-600">
                  <%= product.current_price%>đ
                </span>
                <p class="text-white">(Mong muốn: <span class="text-green-400 font-bold"><%=product.target_price%></span>)</p>
              </div>
              <div class="my-3 border-t border-stone-100"></div>
              <div
                class="flex items-center justify-between gap-1 text-xs text-stone-500"
              ></div>
              <button
              onclick="window.location.href='/product/<%=product.platform%>/<%=product.product_code%>'"
                class="mt-3 w-full rounded-xl bg-amber-50 py-2.5 text-sm font-semibold cursor-pointer text-amber-800 transition hover:bg-[#e09e2d] hover:text-white"
              >
                Xem thêm
              </button>
            </div>
          </div>    
    <%}); %>
    </div>
</div>
